{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT tb.id, tb.team_id, tb.user_id, u.username, tb.banned_by, tb.until, tb.created_at\n        FROM team_bans tb\n        JOIN users u ON u.id = tb.user_id\n        WHERE tb.team_id = $1\n          AND (tb.until IS NULL OR tb.until > now())\n        ORDER BY tb.created_at DESC\n        ",
