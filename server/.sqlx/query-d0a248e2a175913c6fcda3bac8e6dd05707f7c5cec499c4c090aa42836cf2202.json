  "query": "\n        INSERT INTO team_bans (id, team_id, user_id, banned_by, until)\n        VALUES ($1, $2, $3, $4, $5)\n        ON CONFLICT (team_id, user_id) DO UPDATE\n            SET banned_by  = EXCLUDED.banned_by,\n                until      = EXCLUDED.until,\n                created_at = now()\n        RETURNING *\n        ",
