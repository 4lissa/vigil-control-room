  "query": "\n        SELECT tm.id, tm.team_id, tm.user_id, u.username, tm.role::TEXT as \"role!\", tm.joined_at\n        FROM team_members tm\n        JOIN users u ON u.id = tm.user_id\n        WHERE tm.team_id = $1\n        ORDER BY tm.joined_at ASC\n        ",
