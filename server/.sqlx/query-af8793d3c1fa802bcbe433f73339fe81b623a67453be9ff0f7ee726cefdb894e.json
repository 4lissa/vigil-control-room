  "query": "\n        SELECT tr.id, tr.entry_id, tr.user_id, tr.emoji::TEXT as \"emoji!\", tr.created_at\n        FROM timeline_reactions tr\n        JOIN timeline_entries te ON te.id = tr.entry_id\n        WHERE te.incident_id = $1\n        ORDER BY tr.created_at ASC\n        ",
